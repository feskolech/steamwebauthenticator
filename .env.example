# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
JWT_SECRET=change_me_super_secret_jwt
COOKIE_SECRET=change_me_super_secret_cookie
ENCRYPTION_KEY=change_me_32_bytes_minimum

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=steamguard
DB_USER=steamguard
DB_PASSWORD=steamguard
DB_ROOT_PASSWORD=steamguard_root

# Telegram
TELEGRAM_BOT_TOKEN=change_me_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username_without_@

# Optional seed admin (defaults: admin@admin.com/admin123)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123

# Steam polling
STEAM_POLL_INTERVAL_SEC=5

# Shared rate limiting (optional outside Docker; Docker Compose defaults to redis://redis:6379/0)
RATE_LIMIT_REDIS_URL=
# Leave empty for the default prefix derived from NODE_ENV, or override per environment/shared Redis.
RATE_LIMIT_REDIS_PREFIX=

# Production transport security
FORCE_HTTPS=true
# OPENAPI_ENABLED defaults to true in dev/test and false in production.
# Set to true only when you explicitly want to expose /api-docs/openapi.json.

# Cloudflare Turnstile (optional anti-bot registration protection)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
